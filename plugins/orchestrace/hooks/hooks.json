{
  "description": "Kontrola modelu a effortu u subagentů a workflow (skill orchestrace)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Workflow|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/orchestrace-guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
